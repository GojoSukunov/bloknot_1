# Скопируйте в .env (chmod 600) и заполните. .env НИКОГДА не коммитить.

# Домен сайта (без https://). DNS A-запись должна указывать на сервер.
DOMAIN=example.com

# Секреты — сгенерируйте командами из комментариев
SECRET_KEY=            # python3 -c "import secrets;print(secrets.token_urlsafe(64))"
POSTGRES_PASSWORD=     # openssl rand -hex 24   (только hex — спецсимволы ломают URL подключения)
POSTGRES_USER=bloknot
POSTGRES_DB=bloknot

# Непредсказуемый путь админки (без слэшей), например: panel-k3x9q2
ADMIN_URL=

# Необязательно: почта (письма пока не используются), Sentry
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com
# SENTRY_DSN=
